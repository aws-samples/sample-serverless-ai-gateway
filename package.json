{
    "name": "anyco-project-name",
    "scripts": {
        "build": "pnpm --filter @aws-pace/cdk-utils build && pnpm --filter @aws-pace/constructs build && pnpm --filter deploy build",
        "build:webapp": "pnpm --filter webapp build",
        "clean": "pnpm -r clean",
        "dev": "pnpm --filter webapp dev",
        "deploy": "pnpm run build && pnpm run build:webapp && pnpm --filter deploy cdk:deploy",
        "destroy": "pnpm --filter deploy cdk:destroy",
        "synth": "pnpm run build && pnpm run build:webapp && pnpm --filter deploy cdk:synth",
        "diff": "pnpm run build && pnpm run build:webapp && pnpm --filter deploy cdk:diff",
        "test": "pnpm -r test"
    },
    "devDependencies": {
        "@types/node": "^18",
        "constructs": "^10.0.0",
        "prettier": "^3.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.5"
    },
    "dependencies": {
        "aws-cdk-lib": "^2.143.0",
        "cdk-nag": "^2.28.127"
    },
    "pnpm": {
        "overrides": {
            "@types/babel__traverse": "7.18.2",
            "@zkochan/js-yaml": "npm:js-yaml@4.1.0",
            "wrap-ansi": "^7.0.0",
            "npm-check-updates": ">=18.3.0",
            "constructs": ">=10.4.2",
            "@aws/pdk": ">=0.26.14",
            "aws-cdk-lib": ">=2.189.1",
            "cdk-nag": ">=2.34.23",
            "semver@>=7.0.0 <7.5.2": ">=7.5.2",
            "ip@<1.1.9": ">=1.1.9",
            "ip@=2.0.0": ">=2.0.1",
            "follow-redirects@<=1.15.5": ">=1.15.6",
            "tar@<6.2.1": ">=6.2.1",
            "node-fetch@<2.6.7": ">=2.6.7",
            "@babel/helpers": ">=7.26.10",
            "fast-xml-parser": ">=4.4.1",
            "vite": ">=7.1.5",
            "vitest": ">=2.1.9",
            "esbuild": ">=0.25.0",
            "axios": ">=1.12.0",
            "cross-spawn": ">=7.0.5",
            "rollup": ">=4.22.4",
            "micromatch": ">=4.0.8",
            "braces": ">=3.0.3",
            "tmp": ">=0.2.4"
        }
    },
    "engines": {
        "node": ">=16",
        "pnpm": ">=8"
    },
    "main": "lib/index.js",
    "license": "MIT-0",
    "publishConfig": {
        "access": "public"
    },
    "version": "0.0.0",
    "types": "lib/index.d.ts",
    "private": true,
    "workspaces": {
        "packages": [
            "packages/aws-pace/cdk-utils",
            "packages/aws-pace/constructs",
            "packages/deploy",
            "packages/webapp"
        ]
    }
}
